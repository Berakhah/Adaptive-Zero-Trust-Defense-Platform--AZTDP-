# DEV-ONLY defaults for local development. NOT secrets, NOT for production.
# Every value is public (it is committed). Use with:
#   docker compose --env-file .env.dev -f docker-compose.yml -f docker-compose.dev.yml up
# Add your own overrides by listing a second file (later wins):
#   --env-file .env.dev --env-file .env
#
# Why an env file and not the override file: the base docker-compose.yml marks
# secrets as required (${VAR:?...}) and Compose evaluates those guards before it
# merges overrides, so the values must come from the environment, not from
# docker-compose.dev.yml.
POSTGRES_PASSWORD=dev-only-postgres-password
POSTGRES_PASSWORD_URLENCODED=dev-only-postgres-password
REDIS_PASSWORD=dev-only-redis-password
REDIS_PASSWORD_URLENCODED=dev-only-redis-password
AZTDP_INTERNAL_TOKEN=dev-only-internal-token-0123456789abcdef0123456789abcdef
AZTDP_SECRET_KEY=dev-only-django-secret-key-0123456789abcdef0123456789abcdef
AZTDP_STEPUP_SIGNING_KEY=dev-only-stepup-signing-key-0123456789abcdef0123456789
AZTDP_TOTP_MASTER_SECRET=dev-only-totp-master-secret-0123456789abcdef0123456789
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=dev-only-keycloak-admin
# Must match the secret in infra/keycloak/aztdp-realm.dev.json
KEYCLOAK_CLIENT_SECRET=aztdp-secret
GRAFANA_ADMIN_PASSWORD=dev-only-grafana-admin
AZTDP_ALLOWED_HOSTS=localhost,127.0.0.1,django-app
# SOC dashboard login: soc / dev-only-soc
DASHBOARD_HTPASSWD='soc:$apr1$D6SiFAkV$bLaxz0txLA7QsR8dqHs06/'
