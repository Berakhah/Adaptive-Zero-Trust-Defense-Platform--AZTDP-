# AZTDP environment secrets — copy to .env and fill in real values before running.
# NEVER commit .env to source control. All values below are intentionally blank.

# PostgreSQL bootstrap superuser password (used only by postgres, db-migrate and
# pg-backup, whose pg_dumpall must read role password hashes)
POSTGRES_PASSWORD=

# Per-service PostgreSQL role passwords (Task 8; created by db-migrate from
# infra/postgres/04_roles.sql). Each service connects as its own least-privilege
# role; re-run db-migrate after changing one to rotate it.
# Generate each with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# aztdp_owner: migrations + audit retention only
PG_OWNER_PASSWORD=
# telemetry-ingest
PG_INGEST_PASSWORD=
# forensics (read-only)
PG_FORENSICS_PASSWORD=
# gateway (token_revocations)
PG_GATEWAY_PASSWORD=
# anomaly-service (anomaly_baselines)
PG_ANOMALY_PASSWORD=
# django-app (own database aztdp_django)
PG_DJANGO_PASSWORD=
# keycloak (own database keycloak)
PG_KEYCLOAK_PASSWORD=

# Keycloak bootstrap admin
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=

# Django secret key — generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
AZTDP_SECRET_KEY=

# Comma-separated list of valid Django ALLOWED_HOSTS (no wildcards in production)
AZTDP_ALLOWED_HOSTS=

# Shared internal service token — all services must use the same value.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AZTDP_INTERNAL_TOKEN=

# Grafana admin password
GRAFANA_ADMIN_PASSWORD=

# Redis password (Task 4) and its URL-encoded form
REDIS_PASSWORD=
REDIS_PASSWORD_URLENCODED=

# Step-up signing key (Task 5) — python -c "import secrets; print(secrets.token_urlsafe(50))"
AZTDP_STEPUP_SIGNING_KEY=
# TOTP master secret (Task 5) — python -c "import secrets; print(secrets.token_hex(32))"
AZTDP_TOTP_MASTER_SECRET=

# Model artifact HMAC key (Task 11) — python -c "import secrets; print(secrets.token_hex(32))"
AZTDP_MODEL_HMAC_KEY=

# Keycloak client secret (Task 6) — substituted into the realm import at start
KEYCLOAK_CLIENT_SECRET=

# Dashboard basic-auth htpasswd entry (Task 3): a full `user:hash` line.
# Generate: echo "soc:$(openssl passwd -apr1)"  -- wrap in single quotes here
# (hash contains $), e.g. DASHBOARD_HTPASSWD='soc:$apr1$...'
DASHBOARD_HTPASSWD=

# Alert webhook URL (Task 12)
ALERT_WEBHOOK_URL=
