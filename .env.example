# AZTDP environment secrets — copy to .env and fill in real values before running.
# NEVER commit .env to source control.

# PostgreSQL password (used by postgres, keycloak, all backend services)
POSTGRES_PASSWORD=change-me-strong-password

# Keycloak bootstrap admin password
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-strong-password

# Django secret key — generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
AZTDP_SECRET_KEY=change-me-generate-with-python-secrets

# Comma-separated list of valid Django ALLOWED_HOSTS (no wildcards in production)
AZTDP_ALLOWED_HOSTS=localhost,127.0.0.1

# Shared internal service token — all services must use the same value.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AZTDP_INTERNAL_TOKEN=change-me-generate-with-python-secrets

# Grafana admin password
GRAFANA_ADMIN_PASSWORD=change-me-strong-password
